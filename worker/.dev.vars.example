# 复制为 worker/.dev.vars（已被 .gitignore 忽略），仅用于本地 wrangler dev。
# 生成方法：
#   node worker/scripts/hash-secret.mjs jwt        → JWT_SECRET
#   node worker/scripts/hash-secret.mjs password   → ADMIN_PASSWORD_HASH（输入密码，≥12 位）
#   node worker/scripts/hash-secret.mjs token      → 打印 TOKEN（给 MCP 客户端）和 API_TOKEN_HASH
JWT_SECRET=
ADMIN_PASSWORD_HASH=
API_TOKEN_HASH=
# 本地是 http，必须关闭 Secure Cookie
COOKIE_SECURE=false
# 社区模块（可选）：本地默认把验证码打印在 wrangler dev 日志里
EMAIL_PROVIDER=console
# RESEND_API_KEY=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:5173/api/members/google/callback
# SITE_URL=http://localhost:5173
