{
  "name": "@blog/worker",
  "private": true,
  "version": "1.35.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply blog --local",
    "db:migrate:remote": "wrangler d1 migrations apply blog --remote",
    "hash-password": "node scripts/hash-secret.mjs password",
    "hash-token": "node scripts/hash-secret.mjs token"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261009.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/node": "^22.20.5",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wrangler": "4.149.0"
  }
}
