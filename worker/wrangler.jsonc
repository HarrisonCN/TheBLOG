// Cloudflare Worker：博客 API + 管理后台 API + MCP 端点
// 部署前请把 database_id 换成 `wrangler d1 create blog` 输出的 ID，见根目录 README。
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "winston-blog-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "blog",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "blog-images" }],
  // L19 私信实时层：每个好朋友 / 每个活动聊天室一个 Durable Object（WebSocket Hibernation）。
  // 消息都存在 D1（迁移 0016_dm.sql）；不配置这两项时私信照常可用，浏览器自动退回轮询。
  "durable_objects": { "bindings": [{ "name": "DM_HUB", "class_name": "DmHub" }] },
  "migrations": [{ "tag": "dm-v1", "new_sqlite_classes": ["DmHub"] }],
  // 社区模块（可选，见 README「社区模块的密钥与绑定」）：
  // 私有上传桶：{ "binding": "UPLOADS", "bucket_name": "blog-uploads" } 加进 r2_buckets
  // Cloudflare 发信："send_email": [{ "name": "EMAIL" }]
  "vars": {
    // 允许调用 Admin API 的浏览器来源（逗号分隔）。同域部署时填博客域名即可。
    "ALLOWED_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173",
    "SESSION_TTL_SECONDS": "3600",
    "COOKIE_SECURE": "true"
  }
  // 自定义域名（Pages 与 Worker 同域，Cookie 才是第一方）：
  // "routes": [
  //   { "pattern": "blog.example.com/api/*", "zone_name": "example.com" },
  //   { "pattern": "blog.example.com/mcp", "zone_name": "example.com" }
  // ]
}
